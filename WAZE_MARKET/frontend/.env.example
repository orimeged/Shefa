# Copy to .env.local to override the defaults.

# Address encoded in the QR code. Set it when the detected network address is
# wrong, for example http://192.168.1.20:4173
VITE_PUBLIC_ORIGIN=

# Backend that the dev and preview servers proxy /api and /ws to. Local only.
BACKEND_URL=http://127.0.0.1:8000

# The API's own address in production, such as https://shefa-api.onrender.com.
# Built into the bundle, so set it on the host before `npm run build`. Leave it
# empty to keep calls relative, for a proxy or a host's rewrites to forward.
VITE_BACKEND_URL=
