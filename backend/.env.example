# Copy to .env, or set these in the shell, which wins. All of them are optional.

# Smart categorization. Without a key, the food dictionary still places common items.
ANTHROPIC_API_KEY=
# LLM_ENABLED=0 turns it off even with a key. LLM_ENABLED=1 turns it on without
# one, for credentials from `ant auth login`.
# LLM_ENABLED=1
# LLM_MODEL=claude-haiku-5-5

# Dictation. Without a key, the phone falls back on the keyboard's own microphone.
OPENAI_API_KEY=
# STT_MODEL=gpt-transcribe
# STT_ENGINE=stub returns made-up words, for development only.
# STT_ENGINE=none turns dictation off even with a key.

# Photos of shopping lists use the same OpenAI key. The photo is read and dropped.
# LIST_PHOTO_MODEL=gpt-5.4-mini
# LIST_PHOTO_ENGINE=stub reads every photo as the same list, for development only.
# LIST_PHOTO_ENGINE=none turns it off even with a key.

# Where the frontend is served from, comma-separated. Needed once it's on its own
# domain, like https://shefa.vercel.app, for both API calls and dictation's WebSocket.
# CORS_ORIGINS=http://localhost:5173
# Also by pattern, for preview deployments: https://shefa-[a-z0-9-]+\.vercel\.app
# CORS_ORIGIN_REGEX=

# The store managers' dashboard at /admin. Without a token it stays locked.
# Generate one: python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_TOKEN=

# Reports and the dashboard's data live in DATABASE_URL now. A file left at this
# path from before is copied in once, at the first start, and then not read again.
# EVENTS_DB_PATH=var/events.sqlite3

# Decides when "today" starts on the dashboard.
# STORE_TIMEZONE=Asia/Jerusalem

# The app's database: inventory, shoppers' reports and the dashboard's data. SQLite
# by default; in the cloud, the PostgreSQL URL a host gives you (postgres:// works).
# The server applies migrations at startup.
# DATABASE_URL=sqlite:///var/inventory.sqlite3
# DATABASE_URL=postgresql://user:password@host:5432/shefa
